{
  "name": "anomaly-zoo-web",
  "version": "0.0.0",
  "private": true,
  "description": "Anomaly Zoo website: a static Next.js export that replays pre-generated engine traces.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "size": "node scripts/size-gate.mjs",
    "serve": "node scripts/serve.mjs",
    "e2e": "playwright test",
    "lighthouse": "node scripts/lighthouse-check.mjs",
    "og": "node scripts/gen-og.mjs"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "5.3.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "chrome-launcher": "1.2.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "lighthouse": "13.5.0",
    "postcss": "8.5.29",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.3"
  }
}
