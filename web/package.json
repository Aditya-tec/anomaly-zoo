{
  "name": "anomaly-zoo-web",
  "version": "0.0.0",
  "private": true,
  "description": "Anomaly Zoo website: a static Next.js export that replays pre-generated engine traces.",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "size": "node scripts/size-gate.mjs",
    "serve": "node scripts/serve.mjs",
    "e2e": "playwright test",
    "lhci": "lhci autorun --config=lighthouserc.json"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "postcss": "8.5.29",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "3.2.7"
  }
}
